# Supabase 연동 환경변수 (이 파일은 커밋용 템플릿입니다)
# 1) Supabase 대시보드 → 프로젝트 → Project Settings → API 에서 값 확인
# 2) 이 파일을 복사해 .env 로 만들고 실제 값을 채우세요 ( .env 는 git 에 커밋되지 않습니다 )
# 3) 값 변경 후에는 `npx expo start -c` 로 캐시를 지우고 재시작해야 반영됩니다

# Project URL (예: https://abcdefghijklmnop.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=

# anon public key ( public 이므로 앱에 포함해도 안전. service_role 키는 절대 넣지 마세요 )
EXPO_PUBLIC_SUPABASE_ANON_KEY=
